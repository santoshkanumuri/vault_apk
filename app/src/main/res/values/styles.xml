<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PrivateVault" parent="android:style/Theme.Material.NoActionBar">
        <!-- The splash matches the black window behind it, so the black icon circle does not show on a light system theme. -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">#000000</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.PrivateVault.Codes" parent="Theme.PrivateVault">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.65</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
